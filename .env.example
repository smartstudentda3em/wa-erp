APP_NAME="WhatsApp ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ----- Database -----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whatsapp_erp
DB_USERNAME=root
DB_PASSWORD=

# ----- Queue & Cache (Redis) -----
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ----- Broadcasting (Reverb) -----
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=erp-app
REVERB_APP_KEY=erp-key
REVERB_APP_SECRET=erp-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ----- Sanctum SPA -----
SESSION_DRIVER=cookie
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:5173

# ----- WhatsApp Cloud API -----
WHATSAPP_APP_SECRET=            # App Secret من Meta (App Settings → Basic)
WHATSAPP_VERIFY_TOKEN=change-me-verify-token   # اخترته أنت وتضعه في Meta Webhook
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_BROADCAST_RATE=20

# ----- حساب واتساب التجريبي (يقرأه WhatsappAccountSeeder) -----
WA_ACCOUNT_LABEL="رقم الاختبار"
WA_DISPLAY_PHONE=              # الرقم الظاهر: +1555...
WA_PHONE_NUMBER_ID=           # Phone number ID من API Setup
WA_WABA_ID=                   # WhatsApp Business Account ID
WA_ACCESS_TOKEN=              # Temporary/Permanent access token
WA_DAILY_LIMIT=250
